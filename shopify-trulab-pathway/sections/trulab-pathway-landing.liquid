{% liquid
  assign pathway_product = section.settings.product
  assign pathway_variant = pathway_product.selected_or_first_available_variant
%}

{% if customer and customer.tags contains 'clinics' %}
  <script>window.location.replace('/pages/clinic-ordering');</script>
  <style>.tdx-{{ section.id }}{display:none!important}</style>
{% endif %}

<section class="tdx tdx-{{ section.id }}" id="trulab-pathway-{{ section.id }}">
  <header class="tdx-landing-header" aria-label="PATHWAY page navigation">
    <div class="tdx-announcement">Provider-guided genetic insights for more personalized wellness</div>
    <div class="tdx-nav-shell">
      <a class="tdx-nav-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        {% if settings.logo != blank %}
          {{ settings.logo | image_url: width: 420 | image_tag: loading: 'eager', widths: '180, 260, 360, 420', alt: shop.name }}
        {% else %}
          <span class="tdx-logo-mark" aria-hidden="true">◉</span>
          <span class="tdx-logo-type"><strong>TRINITY</strong><small>CELL SCIENCES</small></span>
        {% endif %}
      </a>
      <nav class="tdx-nav-links" aria-label="PATHWAY sections">
        <a href="#tdx-benefits-{{ section.id }}">Benefits</a>
        <a href="#tdx-report-{{ section.id }}">The report</a>
        <a href="#tdx-process-{{ section.id }}">How it works</a>
        <a href="#tdx-clinic-{{ section.id }}">For clinics</a>
      </nav>
      <a class="tdx-nav-order" href="#tdx-order-{{ section.id }}">Order test <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <div class="tdx-hero">
    <div class="tdx-shell tdx-hero-grid">
      <div class="tdx-hero-copy">
        <p class="tdx-eyebrow">TruLab Dx PATHWAY™ Genetic Test</p>
        <h1>Stop guessing.<span>Start with your biology.</span></h1>
        <p class="tdx-lede">One simple cheek swab unlocks a detailed view of the genetic pathways connected to metabolism, longevity, recovery, nutrition, cognition, and personalized wellness.</p>
        <div class="tdx-actions">
          {% if pathway_product != blank %}
            {% form 'product', pathway_product, class: 'tdx-product-form' %}
              <input type="hidden" name="id" value="{{ pathway_variant.id }}">
              <button class="tdx-button" type="submit" name="add" {% unless pathway_variant.available %}disabled{% endunless %}>
                {% if pathway_variant.available %}Order your kit — {{ pathway_variant.price | money_without_trailing_zeros }}{% else %}Coming soon{% endif %}<span aria-hidden="true">→</span>
              </button>
            {% endform %}
          {% else %}
            <a class="tdx-button" href="#tdx-order-{{ section.id }}">Order your kit — {{ section.settings.consumer_price }}<span aria-hidden="true">→</span></a>
          {% endif %}
          <a class="tdx-text-link" href="#tdx-process-{{ section.id }}">See how it works</a>
        </div>
        <div class="tdx-trust"><span>CLIA-certified lab</span><span>At-home cheek swab</span><span>Results in 2–3 weeks</span></div>
      </div>

      <div class="tdx-product-art" aria-label="PATHWAY report and cheek swab kit illustration">
        <div class="tdx-orbit tdx-orbit-a"></div><div class="tdx-orbit tdx-orbit-b"></div>
        <div class="tdx-kit-box">
          <img src="{{ 'pathway-logo.png' | asset_url }}" width="620" height="190" alt="PATHWAY - The Future of Personalized Health" loading="eager">
          <div><small>AT-HOME GENETIC TEST</small><strong>Your biology.<br>Your pathway.</strong><span>Powered by TruLab Dx</span></div>
        </div>
        <div class="tdx-report-book"><span>PERSONALIZED REPORT</span><strong>170</strong><small>pages of genetic insights</small><i></i><i></i><i></i></div>
        <div class="tdx-swab"><b></b><span>Simple cheek swab</span></div>
        <div class="tdx-stat tdx-stat-a"><strong>149</strong>SNPs</div>
        <div class="tdx-stat tdx-stat-b"><strong>600+</strong>gene markers</div>
      </div>
    </div>
  </div>

  <div class="tdx-intro">
    <div class="tdx-shell tdx-intro-grid">
      <h2>Personalized health starts with better information.</h2>
      <p>Not everyone responds to nutrition, supplements, stress, recovery strategies, or peptides the same way. PATHWAY helps translate complex genetics into a clearer starting point for provider-guided wellness.</p>
    </div>
  </div>

  <div class="tdx-section" id="tdx-benefits-{{ section.id }}">
    <div class="tdx-shell">
      <div class="tdx-heading tdx-heading-split">
        <div><p class="tdx-eyebrow">What PATHWAY can help you explore</p><h2>A more personal view of your overall health.</h2></div>
        <p>Your genetics are not your destiny. They are context — a way to understand where your biology may benefit from more thoughtful support.</p>
      </div>
      <div class="tdx-benefit-grid">
        <article><span>01</span><h3>Longevity & cellular support</h3><p>Explore genetic pathways connected to healthy aging, cellular resilience, and long-term wellness planning.</p></article>
        <article><span>02</span><h3>Metabolism & energy</h3><p>Understand variants related to energy use, metabolic function, appetite regulation, and GLP-1 signaling biology.</p></article>
        <article><span>03</span><h3>Recovery & inflammation</h3><p>See how your biology may influence recovery, tissue support, and the way your body responds to everyday stressors.</p></article>
        <article><span>04</span><h3>Cognitive performance</h3><p>Review pathways associated with mental clarity, cognitive resilience, and nervous-system support.</p></article>
        <article><span>05</span><h3>Nutrition & micronutrients</h3><p>Get context around nutrition response, methylation, B vitamins, MTHFR-related markers, and food sensitivity.</p></article>
        <article><span>06</span><h3>Personalized peptide education</h3><p>Use biology-grounded research to have more structured conversations with a qualified healthcare provider.</p></article>
      </div>
    </div>
  </div>

  <div class="tdx-section tdx-report" id="tdx-report-{{ section.id }}">
    <div class="tdx-shell tdx-report-grid">
      <div class="tdx-report-copy">
        <p class="tdx-eyebrow">Your 170-page personalized report</p>
        <h2>From raw genetics to a clearer wellness roadmap.</h2>
        <p>PATHWAY organizes complex marker-level information into six easy-to-follow health categories, with high, medium, and low priority bands that make your results easier to review with your provider.</p>
        <ul><li>Pathway-based genetic insights</li><li>Lifestyle and nutrition considerations</li><li>Supplements and labs to discuss</li><li>Provider-guided peptide research</li></ul>
      </div>
      <div class="tdx-report-stats">
        <article><strong>149</strong><span>SNPs evaluated</span></article>
        <article><strong>600+</strong><span>gene markers represented</span></article>
        <article><strong>14</strong><span>peptide & metabolic pathways</span></article>
        <article><strong>6</strong><span>organized health categories</span></article>
      </div>
    </div>
  </div>

  <div class="tdx-section tdx-offer" id="tdx-order-{{ section.id }}">
    <div class="tdx-shell tdx-offer-card">
      <div>
        <p class="tdx-eyebrow">PATHWAY by TruLab Dx</p>
        <h2>Know more about your biology.</h2>
        <p>Get the complete at-home kit, laboratory processing, and your personalized 170-page wellness report.</p>
        <ul><li>Simple, non-invasive cheek swab</li><li>Return materials included</li><li>CLIA-certified laboratory processing</li><li>Digital report ready to review with your provider</li></ul>
      </div>
      <aside class="tdx-price-card">
        <span>One-time purchase</span>
        <strong>{% if pathway_product != blank %}{{ pathway_variant.price | money_without_trailing_zeros }}{% else %}{{ section.settings.consumer_price }}{% endif %}</strong>
        <small>Includes kit, processing, and report</small>
        {% if pathway_product != blank %}
          {% form 'product', pathway_product, class: 'tdx-product-form' %}
            <input type="hidden" name="id" value="{{ pathway_variant.id }}">
            <button class="tdx-button tdx-button-full" type="submit" name="add" {% unless pathway_variant.available %}disabled{% endunless %}>
              {% if pathway_variant.available %}Add PATHWAY to cart{% else %}Coming soon{% endif %}<span aria-hidden="true">→</span>
            </button>
          {% endform %}
        {% else %}
          <span class="tdx-button tdx-button-full tdx-disabled">Select product in editor</span>
        {% endif %}
        <p>Secure checkout through Trinity Cell Sciences</p>
      </aside>
    </div>
  </div>

  <div class="tdx-section tdx-process" id="tdx-process-{{ section.id }}">
    <div class="tdx-shell">
      <div class="tdx-heading tdx-centered"><p class="tdx-eyebrow">Simple & guided</p><h2>How it works</h2><p>From your door to your personalized report in four straightforward steps.</p></div>
      <div class="tdx-steps">
        <article><span>01</span><h3>Order your kit</h3><p>Your PATHWAY kit is shipped directly to you with clear collection and return instructions.</p></article>
        <article><span>02</span><h3>Complete a cheek swab</h3><p>Collect your sample at home in minutes. No needles, lab visit, or complicated preparation.</p></article>
        <article><span>03</span><h3>Lab analysis</h3><p>Your sample is processed by a CLIA-certified laboratory and evaluated across key genetic markers.</p></article>
        <article><span>04</span><h3>Review your report</h3><p>Receive your personalized 170-page report in approximately 2–3 weeks and discuss it with your provider.</p></article>
      </div>
    </div>
  </div>

  <div class="tdx-clinic" id="tdx-clinic-{{ section.id }}">
    <div class="tdx-shell tdx-clinic-cta">
      <div class="tdx-clinic-copy">
        <p class="tdx-eyebrow">Are you a clinic?</p>
        <h2>Receive wholesale pricing by registering today.</h2>
        <p>Bring provider-guided genetic insights into your clinic with no laboratory equipment or complicated new workflow. Approved partners receive access to wholesale PATHWAY kits, patient-friendly reports, and a structured personalization layer for more informed wellness conversations.</p>
        <div><span>Wholesale partner pricing</span><span>No lab setup required</span><span>170-page patient report</span></div>
      </div>
      <aside class="tdx-clinic-cta-side">
        <p class="tdx-eyebrow">Approved clinic partner?</p>
        <h3>Log in to view your wholesale discount.</h3>
        <p>Wholesale pricing is reserved for approved clinic partners and is displayed after you sign in.</p>
        <a class="tdx-button tdx-button-lime tdx-button-full" href="/pages/clinic-login">{{ section.settings.clinic_login_label | default: 'Clinic partner login' }}<span aria-hidden="true">→</span></a>
        <a class="tdx-clinic-register-link" href="/pages/register">Not registered? Apply for access</a>
      </aside>
    </div>
  </div>

  <div class="tdx-section tdx-faq">
    <div class="tdx-shell tdx-faq-grid">
      <div><p class="tdx-eyebrow">Questions, answered</p><h2>What to know before you test.</h2><p>PATHWAY is designed for informational, provider-guided wellness and optimization.</p></div>
      <div class="tdx-faq-list">
        <details><summary>What does the PATHWAY test analyze?<span>+</span></summary><p>The panel evaluates 149 SNPs representing more than 600 gene markers across peptide, metabolic, recovery, cognitive, nutrition, stress-response, and longevity-related pathways.</p></details>
        <details><summary>Does this test prescribe peptides or treatment?<span>+</span></summary><p>No. The report is educational and is designed to support a more informed conversation with a qualified healthcare provider. It does not diagnose a condition or prescribe treatment.</p></details>
        <details><summary>How long do results take?<span>+</span></summary><p>Most reports are available approximately 2–3 weeks after the laboratory receives and processes your sample.</p></details>
        <details><summary>How do clinics access partner pricing?<span>+</span></summary><p>Clinics can register for partner access through the clinic page. Once approved, sign in to your clinic account to view wholesale pricing and ordering details.</p></details>
      </div>
    </div>
  </div>

  <div class="tdx-final">
    <div class="tdx-shell"><p class="tdx-eyebrow">Your personalized path starts here</p><h2>Stop guessing. Start with your biology.</h2>
      {% if pathway_product != blank %}<a class="tdx-button tdx-button-lime" href="{{ pathway_product.url }}">View the PATHWAY kit<span aria-hidden="true">→</span></a>{% else %}<a class="tdx-button tdx-button-lime" href="#tdx-order-{{ section.id }}">Order your kit — {{ section.settings.consumer_price }}<span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>

  <div class="tdx-disclaimer"><div class="tdx-shell"><strong>PATHWAY™ powered by TruLab Dx</strong><p>For informational use with qualified provider guidance. Intended to support personalized wellness and optimization discussions. Not intended to diagnose, treat, cure, or prevent disease.</p></div></div>
</section>

<script>
  (() => {
    const root = document.querySelector('.tdx-{{ section.id }}');
    if (!root || root.dataset.motionReady === 'true') return;
    root.dataset.motionReady = 'true';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealSelectors = [
      '.tdx-hero-copy', '.tdx-intro-grid > *', '.tdx-heading > *',
      '.tdx-benefit-grid article', '.tdx-report-copy', '.tdx-report-stats article',
      '.tdx-offer-card > *', '.tdx-clinic-copy',
      '.tdx-clinic-cta-side', '.tdx-faq-grid > *', '.tdx-final .tdx-shell'
    ];
    const revealItems = [...root.querySelectorAll(revealSelectors.join(','))];
    const productArt = root.querySelector('.tdx-product-art');

    if (reducedMotion) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
      if (productArt) productArt.classList.add('is-visible');
      return;
    }

    root.classList.add('tdx-motion-ready');
    revealItems.forEach((item, index) => {
      item.classList.add('tdx-reveal');
      item.style.setProperty('--tdx-motion-delay', `${(index % 4) * 85}ms`);
    });
    if (productArt) productArt.classList.add('tdx-motion-fade');

    const items = productArt ? [...revealItems, productArt] : revealItems;
    if (!('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });

    items.forEach((item) => observer.observe(item));

    root.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href || href === '#') return;
        const target = root.querySelector(href);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  })();
</script>

