{% assign tco_is_clinic = false %}
{% if customer and customer.tags contains 'clinics' %}
  {% assign tco_is_clinic = true %}
{% endif %}

{% assign clinic_product = section.settings.product %}
{% if clinic_product == blank %}
  {% assign clinic_product = all_products['trulab-dx-pathway-genetic-test'] %}
{% endif %}
{% assign clinic_variant = clinic_product.selected_or_first_available_variant %}

<section class="tco tco-{{ section.id }}" aria-label="Trinity Cell Sciences clinic ordering portal">
  <div class="tco-announcement">APPROVED CLINIC PARTNER ORDERING</div>

  <header class="tco-header">
    <div class="tco-shell tco-nav">
      <a class="tco-logo" href="/" aria-label="{{ shop.name | escape }} home">
        {% if settings.logo != blank %}
          {{ settings.logo | image_url: width: 520 | image_tag: loading: 'eager', widths: '220, 320, 420, 520', alt: shop.name }}
        {% else %}
          <span class="tco-logo-mark" aria-hidden="true">◉</span>
          <span class="tco-logo-type"><strong>TRINITY</strong><small>CELL SCIENCES</small></span>
        {% endif %}
      </a>

      {% if tco_is_clinic %}
      <nav class="tco-links" aria-label="Clinic portal navigation">
        <a href="#tco-order-{{ section.id }}">Order kits</a>
        <a href="/pages/clinic-portal">Clinic portal</a>
      </nav>
        <a class="tco-nav-cta" href="{{ routes.account_logout_url }}">Sign out <span aria-hidden="true">→</span></a>
      {% else %}
        <nav class="tco-links" aria-label="Clinic access navigation">
          <a href="/pages/trulab-pathway-genetic-test">PATHWAY test</a>
          <a href="/pages/register">Clinic registration</a>
        </nav>
        <a class="tco-nav-cta" href="/pages/register">Apply for access <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>
  </header>

  {% if tco_is_clinic %}
    <main class="tco-main" id="tco-order-{{ section.id }}">
      <div class="tco-shell">
        <div class="tco-intro">
          <div>
            <p class="tco-eyebrow">Clinic partner portal</p>
            <h1>{% if customer.first_name != blank %}Welcome, {{ customer.first_name | escape }}.{% else %}Welcome back.{% endif %}</h1>
            <p>Order PATHWAY genetic testing kits for your practice using the approved pricing connected to your clinic account.</p>
          </div>
          <div class="tco-account-status"><span aria-hidden="true">✓</span><div><strong>Approved clinic account</strong><small>Partner pricing is active for this login.</small></div></div>
        </div>

        {% if clinic_product != blank and clinic_variant != blank %}
          <article class="tco-product product" data-product-id="{{ clinic_product.id }}" data-variant-id="{{ clinic_variant.id }}" data-product-url="{{ clinic_product.url }}">
            <div class="tco-media">
              <span class="tco-product-badge">CLINIC ORDERING</span>
              {% if clinic_product.featured_image != blank %}
                {{ clinic_product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '420, 640, 850, 1200', sizes: '(max-width: 760px) 90vw, 46vw', alt: clinic_product.title }}
              {% else %}
                <div class="tco-image-placeholder">PATHWAY™</div>
              {% endif %}
            </div>

            <div class="tco-product-copy">
              <p class="tco-eyebrow">PATHWAY™ powered by TruLab Dx</p>
              <h2>{{ clinic_product.title | escape }}</h2>
              <p class="tco-product-lede">A simple at-home cheek swab with a personalized 170-page report designed to support provider-guided wellness and optimization conversations.</p>

              <ul class="tco-features">
                <li><span aria-hidden="true">✓</span>149 SNPs representing more than 600 gene markers</li>
                <li><span aria-hidden="true">✓</span>CLIA-certified laboratory analysis</li>
                <li><span aria-hidden="true">✓</span>Results delivered in approximately 2–3 weeks</li>
              </ul>

              <div class="tco-price-wrap">
                <span>YOUR CLINIC PRICE</span>
                <div class="price price--large price--show-badge tco-price" id="price-{{ section.id }}" role="status">
                  <div class="price__container">
                    <div class="price__regular">
                      <span class="visually-hidden visually-hidden--inline">Regular price</span>
                      <span class="price-item price-item--regular money" data-product-price data-variant-id="{{ clinic_variant.id }}">{{ clinic_variant.price | money }}</span>
                    </div>
                    <div class="price__sale">
                      <span class="visually-hidden visually-hidden--inline">Regular price</span>
                      <span><s class="price-item price-item--regular"></s></span>
                      <span class="visually-hidden visually-hidden--inline">Sale price</span>
                      <span class="price-item price-item--sale price-item--last money">{{ clinic_variant.price | money }}</span>
                    </div>
                  </div>
                </div>
                <small>Approved partner pricing is applied through your signed-in clinic account.</small>
              </div>

              {% assign product_form_id = 'tco-product-form-' | append: section.id %}
              {% form 'product', clinic_product, id: product_form_id, class: 'tco-product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
                <input type="hidden" name="id" value="{{ clinic_variant.id }}" data-product-variant-id>
                <div class="tco-order-row">
                  <div class="tco-quantity">
                    <label for="TcoQuantity-{{ section.id }}">Quantity</label>
                    <div class="tco-quantity-control">
                      <button type="button" data-quantity-minus aria-label="Decrease quantity">−</button>
                      <input id="TcoQuantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric">
                      <button type="button" data-quantity-plus aria-label="Increase quantity">+</button>
                    </div>
                  </div>
                  <button class="tco-add-button" type="submit" name="add" {% unless clinic_variant.available %}disabled{% endunless %}>
                    {% if clinic_variant.available %}Add kits to cart{% else %}Contact us to order{% endif %}
                    <span aria-hidden="true">→</span>
                  </button>
                </div>
              {% endform %}

              <div class="tco-order-notes">
                <span><i aria-hidden="true">●</i> Secure Shopify checkout</span>
                <span><i aria-hidden="true">●</i> Clinic account pricing</span>
                <span><i aria-hidden="true">●</i> Direct kit fulfillment</span>
              </div>
            </div>
          </article>
        {% else %}
          <div class="tco-empty"><h2>PATHWAY ordering is temporarily unavailable.</h2><p>Please contact Trinity Cell Sciences for assistance with your clinic order.</p></div>
        {% endif %}

        <div class="tco-support">
          <div><p class="tco-eyebrow">Clinic partner hub</p><h2>Track orders and access education.</h2><p>Open your clinic portal to review Shopify order status, submit kit assignments, and download PATHWAY resources.</p></div>
          <a href="/pages/clinic-portal">Open clinic portal <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </main>
  {% else %}
    <main class="tco-access-main">
      <div class="tco-shell tco-access-grid">
        <div class="tco-access-copy">
          <p class="tco-eyebrow">Protected clinic portal</p>
          <h1>Clinic partner access required.</h1>
          {% if customer %}
            <p>The account currently signed in has not been approved for clinic partner access. Register your practice or sign in with the email connected to your approved application.</p>
          {% else %}
            <p>Sign in with the email connected to your approved clinic account to view PATHWAY ordering and partner pricing.</p>
          {% endif %}
        </div>
        <aside class="tco-access-card">
          <div class="tco-lock" aria-hidden="true">●</div>
          <h2>{% if customer %}Clinic access not found{% else %}Sign in to continue{% endif %}</h2>
          <p>Wholesale pricing is available only to approved TrinityMD clinic partners.</p>
          {% if customer %}
            <a class="tco-access-button" href="{{ routes.account_logout_url }}">Sign out and use another email <span aria-hidden="true">→</span></a>
          {% else %}
            <a class="tco-access-button" href="/account/login?return_url=%2Fpages%2Fclinic-ordering">Continue to secure sign-in <span aria-hidden="true">→</span></a>
          {% endif %}
          <a class="tco-register-link" href="/pages/register">Not registered? Apply for clinic access</a>
        </aside>
      </div>
    </main>
  {% endif %}

  <footer class="tco-footer"><div class="tco-shell"><strong>PATHWAY™ powered by TruLab Dx</strong><span>Provider-guided genetic insights for more personalized wellness.</span></div></footer>
</section>

<script>
  document.documentElement.classList.add('tco-page-active');
  document.body.classList.add('tco-page');
  (function () {
    var root = document.querySelector('.tco-{{ section.id }}');
    if (!root) return;
    var input = root.querySelector('.tco-quantity-control input');
    if (!input) return;
    var minus = root.querySelector('[data-quantity-minus]');
    var plus = root.querySelector('[data-quantity-plus]');
    minus.addEventListener('click', function () { input.value = Math.max(1, Number(input.value || 1) - 1); });
    plus.addEventListener('click', function () { input.value = Math.max(1, Number(input.value || 1) + 1); });
  })();
</script>

