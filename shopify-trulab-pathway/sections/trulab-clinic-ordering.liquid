{% endstyle %}

{% schema %}
{
  "name": "Clinic ordering portal",
  "settings": [
    { "type": "product", "id": "product", "label": "Clinic ordering product" }
  ],
  "presets": [{ "name": "Clinic ordering portal" }]
}
{% endschema %}
