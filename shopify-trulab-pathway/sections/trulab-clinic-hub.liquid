{% assign tch_is_clinic = false %}
{% if customer and customer.tags contains 'clinics' %}
  {% assign tch_is_clinic = true %}
{% endif %}

{% assign tch_unfulfilled_count = 0 %}
{% if tch_is_clinic %}
  {% for order in customer.orders %}
    {% if order.fulfillment_status != 'fulfilled' %}
      {% assign tch_unfulfilled_count = tch_unfulfilled_count | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign tch_patient_pdf_url = section.settings.patient_pdf_url %}
{% if tch_patient_pdf_url == blank %}
  {% assign tch_patient_pdf_url = 'PATHWAY-Patient-Overview.pdf' | asset_url %}
{% endif %}
{% assign tch_clinic_pdf_url = section.settings.clinic_pdf_url %}
{% if tch_clinic_pdf_url == blank %}
  {% assign tch_clinic_pdf_url = 'PATHWAY-Clinic-Overview.pdf' | asset_url %}
{% endif %}
{% assign tch_assignment_api_path = section.settings.assignment_api_path | default: '/apps/pathway-portal/api/assignments' %}

<section class="tch tch-{{ section.id }}" aria-label="TrinityMD PATHWAY clinic hub">
  <div class="tch-announcement">PATHWAY CLINIC PARTNER HUB · APPROVED ACCOUNTS ONLY</div>

  <header class="tch-header">
    <div class="tch-shell tch-nav">
      <a class="tch-logo" href="/" aria-label="{{ shop.name | escape }} home">
        {% if settings.logo != blank %}
          {{ settings.logo | image_url: width: 520 | image_tag: loading: 'eager', widths: '220, 320, 420, 520', alt: shop.name }}
        {% else %}
          <span class="tch-logo-mark" aria-hidden="true">◉</span>
          <span class="tch-logo-type"><strong>TRINITY</strong><small>CELL SCIENCES</small></span>
        {% endif %}
      </a>

      {% if tch_is_clinic %}
        <nav class="tch-links" aria-label="Clinic portal navigation">
          <a href="#tch-orders-{{ section.id }}">Orders</a>
          <a href="#tch-assigned-{{ section.id }}">Assigned kits</a>
          <a href="#tch-assignment-{{ section.id }}">Assign kits</a>
          <a href="#tch-education-{{ section.id }}">Education</a>
          <a href="/pages/clinic-ordering">Order kits</a>
        </nav>
        <a class="tch-nav-cta" href="{{ routes.account_logout_url }}">Sign out <span aria-hidden="true">→</span></a>
      {% else %}
        <nav class="tch-links" aria-label="Clinic access navigation">
          <a href="/pages/trulab-pathway-genetic-test">PATHWAY test</a>
          <a href="/pages/register">Clinic registration</a>
        </nav>
        <a class="tch-nav-cta" href="/pages/register">Apply for access <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>
  </header>

  {% if tch_is_clinic %}
    <main class="tch-main">
      <div class="tch-shell">
        <div class="tch-intro">
          <div>
            <p class="tch-eyebrow">Clinic partner workspace</p>
            <h1>{% if customer.first_name != blank %}Welcome, {{ customer.first_name | escape }}.{% else %}Welcome to your clinic hub.{% endif %}</h1>
            <p>Review your PATHWAY kit orders, submit a kit assignment, and download approved clinic education.</p>
          </div>
          <a class="tch-order-button" href="/pages/clinic-ordering">Order PATHWAY kits <span aria-hidden="true">→</span></a>
        </div>

        <div class="tch-stats" aria-label="Clinic account summary">
          <article><span class="tch-stat-icon" aria-hidden="true">●</span><div><strong>{{ customer.orders_count | default: customer.orders.size }}</strong><p>Total Shopify orders</p><small>Orders placed by this clinic account</small></div></article>
          <article><span class="tch-stat-icon tch-stat-icon--blue" aria-hidden="true">●</span><div><strong>{{ tch_unfulfilled_count }}</strong><p>Orders in progress</p><small>Unfulfilled or partially fulfilled orders</small></div></article>
          <article><span class="tch-stat-icon tch-stat-icon--lime" aria-hidden="true">✓</span><div><strong data-assigned-count>—</strong><p>Assigned kits</p><small>Saved to this clinic account</small></div></article>
        </div>

        <section class="tch-panel" id="tch-orders-{{ section.id }}">
          <div class="tch-panel-heading">
            <div><p class="tch-eyebrow">Shopify fulfillment</p><h2>Kit order status</h2><p>Track payment and shipment progress for orders placed through your clinic account.</p></div>
          </div>

          {% if customer.orders.size > 0 %}
            <div class="tch-order-list">
              <div class="tch-order-head" aria-hidden="true"><span>Order</span><span>Date</span><span>Payment</span><span>Fulfillment</span><span>Total</span></div>
              {% for order in customer.orders limit: 10 %}
                <article class="tch-order-row">
                  <div><strong>{{ order.name | escape }}</strong><small>{{ order.line_items.size }} item{% if order.line_items.size != 1 %}s{% endif %}</small></div>
                  <time datetime="{{ order.created_at | date: '%Y-%m-%d' }}">{{ order.created_at | date: '%b %d, %Y' }}</time>
                  <span class="tch-status tch-status--payment">{{ order.financial_status_label | default: order.financial_status | capitalize }}</span>
                  <span class="tch-status{% if order.fulfillment_status == 'fulfilled' %} tch-status--complete{% elsif order.fulfillment_status == 'partial' %} tch-status--partial{% endif %}">{{ order.fulfillment_status_label | default: order.fulfillment_status | default: 'Unfulfilled' | replace: '_', ' ' | capitalize }}</span>
                  <strong class="tch-order-total">{{ order.total_price | money }}</strong>
                </article>
              {% endfor %}
            </div>
          {% else %}
            <div class="tch-empty"><span aria-hidden="true">□</span><h3>No clinic orders yet.</h3><p>Your PATHWAY kit orders will appear here after checkout.</p><a href="/pages/clinic-ordering">Place your first order <span aria-hidden="true">→</span></a></div>
          {% endif %}
          <p class="tch-order-disclaimer"><span aria-hidden="true">i</span> This section shows Shopify purchase and fulfillment status. Laboratory sample status will be added through the secure PATHWAY portal integration.</p>
        </section>

        <section class="tch-panel tch-assigned" id="tch-assigned-{{ section.id }}" data-assignment-history data-hj-suppress data-dd-privacy="mask" data-clarity-mask="true">
          <div class="tch-panel-heading tch-assigned-heading">
            <div><p class="tch-eyebrow">Clinic assignment records</p><h2>Assigned kits</h2><p>Search previously assigned PATHWAY kits saved to this clinic account.</p></div>
            <label class="tch-record-search"><span class="visually-hidden">Search assigned kits</span><input type="search" data-record-search placeholder="Search kit, client, or email" disabled></label>
          </div>
          <div class="tch-record-state" data-record-state role="status">Connecting to secure kit records…</div>
          <div class="tch-record-list" data-record-list hidden>
            <div class="tch-record-head" aria-hidden="true"><span>Kit ID</span><span>Client</span><span>Email</span><span>Assigned</span><span>Status</span></div>
            <div data-record-rows></div>
          </div>
        </section>

        <section class="tch-assignment" id="tch-assignment-{{ section.id }}">
          <div class="tch-assignment-copy">
            <p class="tch-eyebrow">Secure kit assignment</p>
            <h2>Assign one or multiple kits.</h2>
            <p>Add the kit ID, client email address, and only the client’s first initial plus full last name. Submit up to 25 kit assignments together.</p>
            <div class="tch-privacy-note"><span aria-hidden="true">!</span><div><strong>Enter only the requested minimum information.</strong><p>Use a format such as <em>J. Smith</em>. Do not enter a full first name, date of birth, diagnosis, genetic result, medication, or treatment information.</p></div></div>
            <ul><li><span>1</span>Locate the unique ID printed on each PATHWAY kit.</li><li><span>2</span>Add the client email and first initial with last name.</li><li><span>3</span>Save the batch to this clinic’s assignment history.</li></ul>
          </div>

          <div class="tch-assignment-card">
            {% assign tch_form_id = 'TchAssignmentForm-' | append: section.id %}
            <form id="{{ tch_form_id }}" class="tch-form" data-assignment-api="{{ tch_assignment_api_path | escape }}" data-hj-suppress data-dd-privacy="mask" data-clarity-mask="true">
              <div class="tch-form-heading"><p class="tch-eyebrow">Secure clinic record</p><h3>Kit assignment batch</h3><span>Signed in as {{ customer.email | escape }}</span></div>
              <div class="tch-form-errors" data-form-error role="alert" hidden></div>
              <div class="tch-form-success tch-form-success--inline" data-form-success tabindex="-1" hidden><span aria-hidden="true">✓</span><div><strong>Assignments saved.</strong><p>The kits are now available in this clinic’s assignment history.</p></div></div>

              <div class="tch-fields">
                <div class="tch-kit-list" data-kit-list>
                  <div class="tch-kit-row" data-kit-row>
                    <div class="tch-kit-row-heading"><strong data-kit-label>Kit 1</strong><button type="button" data-remove-kit aria-label="Remove kit 1">Remove</button></div>
                    <label><span>PATHWAY kit ID</span><input type="text" data-kit-id maxlength="64" autocomplete="off" autocapitalize="characters" pattern="[A-Za-z0-9._-]{4,64}" required placeholder="ID printed on the kit"></label>
                    <label><span>Client email address</span><input type="email" data-client-email maxlength="254" autocomplete="email" required placeholder="client@example.com"></label>
                    <label class="tch-client-name-field"><span>Client first initial + last name</span><input type="text" data-client-name maxlength="90" autocomplete="off" required placeholder="Example: J. Smith"></label>
                  </div>
                </div>
                <button class="tch-add-kit" type="button" data-add-kit><span aria-hidden="true">+</span> Add another kit</button>
                <p class="tch-kit-limit">Up to 25 kits per submission. Each PATHWAY kit ID can be assigned only once.</p>
                <label class="tch-check"><input type="checkbox" required><span>I confirm that I entered only the kit ID, client email, and first initial with last name—and did not include a full first name, date of birth, diagnosis, test result, medication, or treatment information.</span></label>
              </div>
              <button class="tch-submit" type="submit" disabled>Connect secure records to submit <span aria-hidden="true">→</span></button>
              <p class="tch-form-footnote">Assignments are encrypted before database storage and are shown only for the signed-in clinic account.</p>
            </form>
          </div>
        </section>

        <section class="tch-panel tch-education" id="tch-education-{{ section.id }}">
          <div class="tch-panel-heading">
            <div><p class="tch-eyebrow">PATHWAY resource center</p><h2>Education materials</h2><p>Download approved resources for staff education and provider-guided client conversations.</p></div>
          </div>
          <div class="tch-resource-grid">
            <article><span class="tch-pdf">PDF</span><div><small>Patient education</small><h3>PATHWAY Patient Overview</h3><p>A concise introduction to sample collection and the personalized genetic report.</p><a href="{{ tch_patient_pdf_url }}" target="_blank" rel="noopener">Download patient PDF <span aria-hidden="true">↓</span></a></div></article>
            <article><span class="tch-pdf">PDF</span><div><small>Clinic education</small><h3>PATHWAY Clinic Overview</h3><p>Extended provider-facing information on workflow, reporting, and clinic use.</p><a href="{{ tch_clinic_pdf_url }}" target="_blank" rel="noopener">Download clinic PDF <span aria-hidden="true">↓</span></a></div></article>
            <article><span class="tch-pdf tch-pdf--guide">170</span><div><small>Report support</small><h3>Provider Review Resources</h3><p>Access approved material for navigating PATHWAY insights with clients.</p>{% if section.settings.education_page_url != blank %}<a href="{{ section.settings.education_page_url }}">Open education center <span aria-hidden="true">→</span></a>{% else %}<span class="tch-resource-pending">Add education link in theme settings</span>{% endif %}</div></article>
          </div>
          <p class="tch-education-note">PATHWAY resources support provider-guided wellness discussions and do not replace clinical judgment or prescribe treatment.</p>
        </section>

        <section class="tch-support"><div><p class="tch-eyebrow">Clinic support</p><h2>Need help with an order or assignment?</h2><p>Contact the TrinityMD clinic team and include your clinic email and Shopify order number.</p></div><a href="mailto:{{ section.settings.support_email | default: shop.email | escape }}">Contact clinic support <span aria-hidden="true">→</span></a></section>
      </div>
    </main>
  {% else %}
    <main class="tch-access-main">
      <div class="tch-shell tch-access-grid">
        <div><p class="tch-eyebrow">Protected clinic hub</p><h1>Approved clinic access required.</h1><p>Sign in with the email connected to your approved TrinityMD clinic account to view orders, assignment requests, and education.</p></div>
        <aside><span class="tch-lock" aria-hidden="true">●</span><h2>{% if customer %}Clinic access not found{% else %}Sign in to continue{% endif %}</h2><p>This hub is available only to approved clinic accounts tagged for partner access.</p>{% if customer %}<a class="tch-access-button" href="{{ routes.account_logout_url }}">Sign out and use another email <span aria-hidden="true">→</span></a>{% else %}<a class="tch-access-button" href="/account/login?return_url=%2Fpages%2Fclinic-portal">Continue to secure sign-in <span aria-hidden="true">→</span></a>{% endif %}<a class="tch-register-link" href="/pages/register">Not registered? Apply for clinic access</a></aside>
      </div>
    </main>
  {% endif %}

  <footer class="tch-footer"><div class="tch-shell"><strong>PATHWAY™ powered by TruLab Dx</strong><span>Provider-guided genetic insights for more personalized wellness.</span></div></footer>
</section>

<script>
  document.documentElement.classList.add('tch-page-active');
  document.body.classList.add('tch-page');
  (function () {
    var root = document.querySelector('.tch-{{ section.id }}');
    if (!root) return;
    var form = root.querySelector('.tch-form');
    if (!form) return;
    var list = form.querySelector('[data-kit-list]');
    var addButton = form.querySelector('[data-add-kit]');
    var submitButton = form.querySelector('.tch-submit');
    var formError = form.querySelector('[data-form-error]');
    var formSuccess = form.querySelector('[data-form-success]');
    var recordState = root.querySelector('[data-record-state]');
    var recordList = root.querySelector('[data-record-list]');
    var recordRows = root.querySelector('[data-record-rows]');
    var recordSearch = root.querySelector('[data-record-search]');
    var assignedCount = root.querySelector('[data-assigned-count]');
    var apiPath = form.getAttribute('data-assignment-api');
    var maxKits = 25;
    var csrfToken = '';
    var assignments = [];
    var clientNamePattern = /^(\p{L})\.?\s+([\p{L}\p{M}'’.-]+(?:\s+[\p{L}\p{M}'’.-]+)*)$/u;
    if (!list || !addButton || !submitButton || !recordState || !recordList || !recordRows || !recordSearch || !apiPath) return;

    function setFormReady(ready) {
      submitButton.disabled = !ready;
      submitButton.innerHTML = ready ? 'Save assignment batch <span aria-hidden="true">→</span>' : 'Connect secure records to submit <span aria-hidden="true">→</span>';
    }

    function showFormError(message) {
      formError.textContent = message || '';
      formError.hidden = !message;
      if (message) formSuccess.hidden = true;
    }

    function statusLabel(value) {
      return String(value || 'assigned').replace(/_/g, ' ').replace(/\b\w/g, function (letter) { return letter.toUpperCase(); });
    }

    function recordCell(label, value, className) {
      var cell = document.createElement('div');
      cell.className = 'tch-record-cell ' + (className || '');
      var small = document.createElement('small');
      small.textContent = label;
      var strong = document.createElement('strong');
      strong.textContent = value;
      cell.appendChild(small);
      cell.appendChild(strong);
      return cell;
    }

    function renderAssignments() {
      var query = recordSearch.value.trim().toLowerCase();
      var filtered = assignments.filter(function (item) {
        return !query || [item.kitId, item.clientName, item.clientEmail, item.status].join(' ').toLowerCase().indexOf(query) !== -1;
      });
      recordRows.replaceChildren();
      assignedCount.textContent = assignments.length;

      if (!filtered.length) {
        recordList.hidden = true;
        recordState.hidden = false;
        recordState.classList.remove('is-error');
        recordState.textContent = assignments.length ? 'No assigned kits match that search.' : 'No kits have been assigned to this clinic yet.';
        return;
      }

      filtered.forEach(function (item) {
        var row = document.createElement('article');
        row.className = 'tch-record-row';
        row.appendChild(recordCell('Kit ID', item.kitId, 'tch-record-kit'));
        row.appendChild(recordCell('Client', item.clientName, 'tch-record-client'));
        row.appendChild(recordCell('Email', item.clientEmail, 'tch-record-email'));

        var dateCell = document.createElement('div');
        dateCell.className = 'tch-record-cell tch-record-date';
        var dateLabel = document.createElement('small');
        dateLabel.textContent = 'Assigned';
        var date = document.createElement('time');
        var createdAt = new Date(item.createdAt);
        date.dateTime = item.createdAt;
        date.textContent = Number.isNaN(createdAt.getTime()) ? '—' : createdAt.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
        dateCell.appendChild(dateLabel);
        dateCell.appendChild(date);
        row.appendChild(dateCell);

        var status = document.createElement('span');
        status.className = 'tch-status tch-status--assignment';
        status.textContent = statusLabel(item.status);
        row.appendChild(status);
        recordRows.appendChild(row);
      });
      recordState.hidden = true;
      recordList.hidden = false;
    }

    async function responsePayload(response) {
      try { return await response.json(); } catch (error) { return {}; }
    }

    async function loadAssignments() {
      recordState.hidden = false;
      recordState.classList.remove('is-error');
      recordState.textContent = 'Loading secure kit records…';
      recordList.hidden = true;
      setFormReady(false);
      try {
        var response = await fetch(apiPath, { headers: { Accept: 'application/json' }, credentials: 'same-origin', cache: 'no-store' });
        var payload = await responsePayload(response);
        if (!response.ok) throw new Error(payload.error || 'Secure kit records are not connected yet.');
        assignments = Array.isArray(payload.assignments) ? payload.assignments : [];
        csrfToken = payload.csrfToken || '';
        if (!csrfToken) throw new Error('The secure portal session could not be started.');
        recordSearch.disabled = false;
        renderAssignments();
        setFormReady(true);
      } catch (error) {
        csrfToken = '';
        assignedCount.textContent = '—';
        recordSearch.disabled = true;
        recordState.hidden = false;
        recordState.classList.add('is-error');
        recordState.textContent = error.message || 'Secure kit records are unavailable.';
        setFormReady(false);
      }
    }

    function updateRows() {
      var rows = list.querySelectorAll('[data-kit-row]');
      rows.forEach(function (row, index) {
        var number = index + 1;
        row.querySelector('[data-kit-label]').textContent = 'Kit ' + number;
        var remove = row.querySelector('[data-remove-kit]');
        remove.hidden = rows.length === 1;
        remove.setAttribute('aria-label', 'Remove kit ' + number);
      });
      addButton.disabled = rows.length >= maxKits;
      addButton.hidden = rows.length >= maxKits;
    }

    addButton.addEventListener('click', function () {
      var rows = list.querySelectorAll('[data-kit-row]');
      if (rows.length >= maxKits) return;
      var row = rows[0].cloneNode(true);
      row.querySelectorAll('input').forEach(function (input) {
        input.value = '';
        input.setCustomValidity('');
      });
      list.appendChild(row);
      updateRows();
      row.querySelector('[data-kit-id]').focus();
    });

    list.addEventListener('click', function (event) {
      var remove = event.target.closest('[data-remove-kit]');
      if (!remove) return;
      var rows = list.querySelectorAll('[data-kit-row]');
      if (rows.length === 1) return;
      remove.closest('[data-kit-row]').remove();
      updateRows();
    });

    list.addEventListener('input', function (event) {
      if (event.target.matches('input')) event.target.setCustomValidity('');
      showFormError('');
      formSuccess.hidden = true;
    });

    recordSearch.addEventListener('input', renderAssignments);

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      showFormError('');
      formSuccess.hidden = true;
      if (!csrfToken) {
        showFormError('Secure kit records are not connected. Please try again after the portal connection is completed.');
        return;
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      var batch = [];
      var seenKitIds = {};
      var duplicateInput = null;
      var invalidNameInput = null;
      list.querySelectorAll('[data-kit-row]').forEach(function (row) {
        var kitInput = row.querySelector('[data-kit-id]');
        var emailInput = row.querySelector('[data-client-email]');
        var nameInput = row.querySelector('[data-client-name]');
        var kitId = kitInput.value.trim().toUpperCase();
        var clientEmail = emailInput.value.trim().toLowerCase();
        var suppliedName = nameInput.value.trim().replace(/\s+/g, ' ');
        var nameMatch = suppliedName.match(clientNamePattern);
        kitInput.value = kitId;
        emailInput.value = clientEmail;
        if (!nameMatch) invalidNameInput = invalidNameInput || nameInput;
        var clientName = nameMatch ? nameMatch[1].toLocaleUpperCase() + '. ' + nameMatch[2] : suppliedName;
        nameInput.value = clientName;
        if (seenKitIds[kitId]) duplicateInput = kitInput;
        seenKitIds[kitId] = true;
        batch.push({ kitId: kitId, clientEmail: clientEmail, clientName: clientName });
      });
      if (invalidNameInput) {
        invalidNameInput.setCustomValidity('Use only the first initial and full last name, such as J. Smith.');
        invalidNameInput.reportValidity();
        return;
      }
      if (duplicateInput) {
        duplicateInput.setCustomValidity('Each PATHWAY kit ID can be entered only once.');
        duplicateInput.reportValidity();
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = 'Saving assignments…';
      try {
        var response = await fetch(apiPath, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          cache: 'no-store',
          body: JSON.stringify({ csrfToken: csrfToken, assignments: batch })
        });
        var payload = await responsePayload(response);
        if (!response.ok) throw new Error(payload.error || 'The assignments could not be saved.');

        while (list.querySelectorAll('[data-kit-row]').length > 1) list.lastElementChild.remove();
        list.querySelectorAll('input').forEach(function (input) { input.value = ''; input.setCustomValidity(''); });
        form.querySelector('.tch-check input').checked = false;
        updateRows();
        formSuccess.hidden = false;
        formSuccess.focus();
        await loadAssignments();
      } catch (error) {
        showFormError(error.message || 'The assignments could not be saved.');
        setFormReady(Boolean(csrfToken));
      }
    });
    updateRows();
    loadAssignments();
  })();
</script>

{% style %}
