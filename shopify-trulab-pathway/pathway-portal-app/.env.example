# PORT is used only by the optional Docker/local Node server. Netlify does not need it.
PORT=3000
SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=replace-with-shopify-app-client-id
SHOPIFY_API_SECRET=replace-with-shopify-app-client-secret
# For a legacy custom app only, omit SHOPIFY_CLIENT_ID and set this instead:
# SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-legacy-custom-app-admin-token
PORTAL_TOKEN_SECRET=replace-with-a-separate-random-secret
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
APP_PROXY_MAX_AGE_SECONDS=300
CLINIC_TAG=clinics
