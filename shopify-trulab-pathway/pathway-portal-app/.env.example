# PORT is used only by the optional Docker/local Node server. Netlify does not need it.
PORT=3000
SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=replace-with-shopify-app-client-id
SHOPIFY_API_SECRET=replace-with-shopify-app-client-secret
# For a legacy custom app only, omit SHOPIFY_CLIENT_ID and set this instead:
# SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-legacy-custom-app-admin-token
PORTAL_TOKEN_SECRET=replace-with-a-separate-random-secret
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
APP_PROXY_MAX_AGE_SECONDS=300
CLINIC_TAG=clinics

# ---- Clinic portal v3 (off by default; see CLINIC-PORTAL-V3.md) ----
# Turns on /proxy/clinic, /proxy/apply, /proxy/api/clinic/*, /staff and /staff/api/*.
CLINIC_PORTAL_ENABLED=false
# manual (staff review) or auto (mirror the current Massy auto-approval). Owner decision pending.
CLINIC_APPROVAL_MODE=manual
# When false, approvals are recorded but the clinics tag must be added by hand.
CLINIC_CUSTOMER_TAGGING_ENABLED=false
# Optional strict label format, e.g. TL\d{8} (earlier source documented TL + 8 digits). Confirm against real labels first.
KIT_ID_PATTERN=
KIT_ID_EXAMPLE=
# Comma-separated Shopify staff user IDs allowed into the review console. Empty = any staff with app access.
STAFF_USER_IDS=
# Where the portal's static JS/CSS are served. Defaults to Netlify's DEPLOY_PRIME_URL / URL.
PORTAL_ASSET_BASE_URL=
STOREFRONT_URL=https://trinitymd.shop

# ---- GoHighLevel clinic sign-up (replaces the Massy registration form; see MASSY-REPLACEMENT.md) ----
# Turns on POST /webhooks/ghl/clinic-signup. Each valid submission is tagged CLINIC_TAG immediately.
GHL_SIGNUP_ENABLED=false
# Shared secret the GHL Custom Webhook sends in the x-trinity-webhook-secret header. 32+ random characters.
GHL_WEBHOOK_SECRET=
# Require a valid (check-digit) NPI before granting wholesale pricing. Default true.
GHL_REQUIRE_NPI=true
