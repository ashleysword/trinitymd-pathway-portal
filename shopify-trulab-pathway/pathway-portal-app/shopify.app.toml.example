name = "TrinityMD PATHWAY Portal"
client_id = "replace-with-app-client-id"
application_url = "https://your-pathway-portal.netlify.app"
embedded = false

[auth]
redirect_urls = ["https://your-pathway-portal.netlify.app/"]

[webhooks]
api_version = "2026-07"

[access_scopes]
scopes = "read_customers,write_customers,read_metaobjects,write_metaobjects,write_app_proxy,write_content"

[page.metafields.app.affiliate_name]
name = "Affiliate name"
description = "Affiliate, clinic, or partner name displayed on this PATHWAY landing page."
type = "single_line_text_field"
access.admin = "merchant_read_write"

[page.metafields.app.affiliate_credentials]
name = "Affiliate credentials"
description = "Optional professional title or credentials displayed below the affiliate name."
type = "single_line_text_field"
access.admin = "merchant_read_write"

[page.metafields.app.affiliate_logo]
name = "Affiliate logo"
description = "Logo displayed beside Trinity Cell Sciences branding."
type = "file_reference"
access.admin = "merchant_read_write"

[page.metafields.app.affiliate_photo]
name = "Affiliate photo"
description = "Optional affiliate headshot or branded hero image."
type = "file_reference"
access.admin = "merchant_read_write"

[page.metafields.app.affiliate_headline]
name = "Affiliate headline"
description = "Primary headline for this affiliate landing page."
type = "single_line_text_field"
access.admin = "merchant_read_write"

[page.metafields.app.affiliate_message]
name = "Affiliate welcome message"
description = "Personalized introductory message from the affiliate."
type = "rich_text_field"
access.admin = "merchant_read_write"

[page.metafields.app.affiliate_discount_code]
name = "Affiliate discount code"
description = "Unique Shopify discount code that provides the additional 5% affiliate savings."
type = "single_line_text_field"
access.admin = "merchant_read_write"

[page.metafields.app.affiliate_tracking_id]
name = "Affiliate tracking ID"
description = "Stable identifier stored on the cart and PATHWAY order line for attribution."
type = "single_line_text_field"
access.admin = "merchant_read_write"
capabilities.unique_values = true

[page.metafields.app.affiliate_testimonial]
name = "Affiliate testimonial"
description = "Optional affiliate quotation shown between the benefits and process sections."
type = "multi_line_text_field"
access.admin = "merchant_read_write"

[page.metafields.app.affiliate_accent_color]
name = "Affiliate accent color"
description = "Optional brand accent color for this affiliate page."
type = "color"
access.admin = "merchant_read_write"

[metaobjects.app.pathway_assignment]
name = "PATHWAY Kit Assignment"
description = "Clinic-owned PATHWAY kit assignment record. Client identifiers are application encrypted."
display_name_field = "kit_id"
access.admin = "merchant_read"
access.storefront = "none"

[metaobjects.app.pathway_assignment.fields.kit_id]
name = "Kit ID"
description = "Normalized TruLab Dx PATHWAY kit identifier."
type = "single_line_text_field"
required = true

[metaobjects.app.pathway_assignment.fields.clinic_customer_id]
name = "Clinic customer ID"
description = "Shopify customer ID for the clinic that owns this assignment."
type = "single_line_text_field"
required = true

[metaobjects.app.pathway_assignment.fields.client_email_encrypted]
name = "Encrypted client email"
description = "AES-256-GCM encrypted client email; readable only through the portal service."
type = "single_line_text_field"
required = true

[metaobjects.app.pathway_assignment.fields.client_name_encrypted]
name = "Encrypted client name"
description = "AES-256-GCM encrypted first initial and last name; readable only through the portal service."
type = "single_line_text_field"
required = true

[metaobjects.app.pathway_assignment.fields.status]
name = "Kit status"
type = "single_line_text_field"
required = true
validations.choices = ["assigned", "kit_received", "processing", "report_ready", "complete", "cancelled"]

[metaobjects.app.pathway_assignment.fields.provider_review_status]
name = "Provider review status"
type = "single_line_text_field"
required = true
validations.choices = ["not_started", "pending", "reviewed"]

[metaobjects.app.pathway_assignment.fields.assigned_at]
name = "Assigned at"
type = "date_time"
required = true

[metaobjects.app.pathway_assignment.fields.updated_at]
name = "Record updated at"
type = "date_time"
required = true

[customer.metafields.app.pathway_assignments]
name = "PATHWAY kit assignments"
description = "Private reference index for this clinic's PATHWAY kit assignment records."
type = "list.metaobject_reference<$app:pathway_assignment>"
access.admin = "merchant_read"
access.storefront = "none"
access.customer_account = "none"

# Clinic portal v3 records. Every type shares the same shape: three filterable
# index fields used by the service for lookups, and a JSON payload.

# Live definitions for the customer kit registry (/proxy/api/customer-kits).
# Keep them: a deploy without them would delete the definitions and their data.
[metaobjects.app.pathway_customer_kit]
name = "PATHWAY Customer Kit"
description = "Customer-owned PATHWAY kit registration. Kit ID is application encrypted."
display_name_field = "kit_label"

  [metaobjects.app.pathway_customer_kit.access]
  admin = "merchant_read"
  storefront = "none"

[metaobjects.app.pathway_customer_kit.fields.kit_label]
name = "Masked kit label"
description = "Display-safe label containing only the final four Kit ID digits."
type = "single_line_text_field"
required = true

[metaobjects.app.pathway_customer_kit.fields.kit_id_encrypted]
name = "Encrypted Kit ID"
description = "AES-256-GCM encrypted PATHWAY Kit ID; readable only through the portal service."
type = "single_line_text_field"
required = true

[metaobjects.app.pathway_customer_kit.fields.customer_id]
name = "Customer ID"
description = "Shopify customer ID that owns this kit registration."
type = "single_line_text_field"
required = true

[metaobjects.app.pathway_customer_kit.fields.registration_source]
name = "Registration source"
type = "single_line_text_field"
required = true

  [metaobjects.app.pathway_customer_kit.fields.registration_source.validations]
  choices = [ "manual", "barcode" ]

[metaobjects.app.pathway_customer_kit.fields.registered_at]
name = "Registered at"
type = "date_time"
required = true

[customer.metafields.app.pathway_customer_kits]
name = "PATHWAY customer kits"
description = "Private reference index for this customer's encrypted PATHWAY kit registrations."
type = "list.metaobject_reference<$app:pathway_customer_kit>"

  [customer.metafields.app.pathway_customer_kits.access]
  admin = "merchant_read"
  storefront = "none"
  customer_account = "none"

[metaobjects.app.portal_application]
name = "Clinic Portal Application"
description = "Clinic wholesale application. Tax ID and reseller permit are application-encrypted inside payload."
access.admin = "merchant_read"
access.storefront = "none"

[metaobjects.app.portal_application.fields.owner]
name = "Clinic customer ID"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_application.fields.status]
name = "Status"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_application.fields.lookup_key]
name = "Lookup key"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_application.fields.payload]
name = "Payload"
type = "json"
required = true

[metaobjects.app.portal_kit]
name = "Clinic Portal Kit"
description = "Kit registered by an approved clinic. Kit ID and clinic only; no patient data."
access.admin = "merchant_read"
access.storefront = "none"

[metaobjects.app.portal_kit.fields.owner]
name = "Clinic customer ID"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_kit.fields.status]
name = "Status"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_kit.fields.lookup_key]
name = "Lookup key"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_kit.fields.payload]
name = "Payload"
type = "json"
required = true

[metaobjects.app.portal_kit_event]
name = "Clinic Portal Kit Event"
description = "Timeline entry for a clinic portal kit (registration, status change, reassignment)."
access.admin = "merchant_read"
access.storefront = "none"

[metaobjects.app.portal_kit_event.fields.owner]
name = "Clinic customer ID"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_kit_event.fields.status]
name = "Status"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_kit_event.fields.lookup_key]
name = "Lookup key"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_kit_event.fields.payload]
name = "Payload"
type = "json"
required = true

[metaobjects.app.portal_document]
name = "Clinic Portal Document"
description = "Clinic resource metadata. File bytes are stored privately outside Shopify Files."
access.admin = "merchant_read"
access.storefront = "none"

[metaobjects.app.portal_document.fields.owner]
name = "Clinic customer ID"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_document.fields.status]
name = "Status"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_document.fields.lookup_key]
name = "Lookup key"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_document.fields.payload]
name = "Payload"
type = "json"
required = true

[metaobjects.app.portal_thread]
name = "Clinic Portal Conversation"
description = "Clinic-to-staff conversation header with read markers."
access.admin = "merchant_read"
access.storefront = "none"

[metaobjects.app.portal_thread.fields.owner]
name = "Clinic customer ID"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_thread.fields.status]
name = "Status"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_thread.fields.lookup_key]
name = "Lookup key"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_thread.fields.payload]
name = "Payload"
type = "json"
required = true

[metaobjects.app.portal_message]
name = "Clinic Portal Message"
description = "Single message in a clinic-to-staff conversation. Not for patient health information."
access.admin = "merchant_read"
access.storefront = "none"

[metaobjects.app.portal_message.fields.owner]
name = "Clinic customer ID"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_message.fields.status]
name = "Status"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_message.fields.lookup_key]
name = "Lookup key"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_message.fields.payload]
name = "Payload"
type = "json"
required = true

[metaobjects.app.portal_audit]
name = "Clinic Portal Audit Entry"
description = "Append-only audit trail for staff and clinic actions."
access.admin = "merchant_read"
access.storefront = "none"

[metaobjects.app.portal_audit.fields.owner]
name = "Clinic customer ID"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_audit.fields.status]
name = "Status"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_audit.fields.lookup_key]
name = "Lookup key"
type = "single_line_text_field"
capabilities.admin_filterable = true

[metaobjects.app.portal_audit.fields.payload]
name = "Payload"
type = "json"
required = true

[app_proxy]
url = "/proxy"
prefix = "apps"
subpath = "pathway-portal"

[build]
automatically_update_urls_on_dev = false
include_config_on_deploy = true
